- id: agent-default-model
  config:
    provider: tinkerproxy
    model: thinkingmachines/Inkling-Small:peft:262144

- id: llm-pi-ai
  config:
    providers:
      tinkerproxy:
        apiKeyEnv: DSH_PROXY_KEY
        api: openai-completions
        baseURL: ${DSH_PROXY_BASE_URL}
        compat:
          supportsDeveloperRole: false
          maxTokensField: max_tokens
        models:
          - id: thinkingmachines/Inkling-Small:peft:262144
            contextWindow: 262144
            maxOutputTokens: 16384

# Match the reference harness persona exactly. DSH ships its own identity line and a
# "Current runtime context" user message describing harness file policy; the reference
# sends neither, so both must be turned off or the prompt differs from the baseline.
- id: system-prompt
  config:
    includeHarnessIdentity: false
    includeRuntimeContext: false
    personaPrefix: ${DSH_PERSONA}
    personaSuffix: ''

# Plan mode prepends a "stay in plan mode, do not edit" section and exposes an
# exit_plan_mode tool the reference harness does not have. For a task whose whole
# objective is producing a patch, that is a direct handicap rather than a neutral default.
- id: plan-mode
  disabled: true

# Agent instructions inject an extra user-role message carrying DSH house rules
# (issue-tracker conventions, delegation advice, and similar). The reference harness
# sends the task instruction alone, so leaving this on would add prompt content the
# baseline never saw.
- id: agent-instructions
  disabled: true

# The reference harness exposes exactly one repository tool. Keeping the tool surface
# identical to the native baseline is what makes a harness-behaviour change attributable.
- id: tool-bash
  disabled: true
- id: tool-pwsh
  disabled: true
- id: tool-fs
  disabled: true
- id: tool-fs-search
  disabled: true
- id: tool-jobs
  disabled: true
- id: tool-web
  disabled: true
- id: tool-subagent
  disabled: true
- id: tool-subagent-fork
  disabled: true
- id: tool-subagent-control
  disabled: true
- id: tool-subagent-list-agents
  disabled: true
- id: tool-workflow
  disabled: true
- id: tool-ralph
  disabled: true
- id: tool-goal
  disabled: true
- id: tool-todo
  disabled: true
- id: tool-skill
  disabled: true

# Session-title generation issues one extra model request per episode. The reference
# harness has no such call, and the proxy counts every upstream request against the same
# 40-request budget, so leaving it on spends a turn the baseline never spent.
- id: session-title-first-prompt-llm
  disabled: true
- id: session-title-llm
  disabled: true
- id: session-title
  disabled: true

# The reference shows the model up to 12,000 characters of tool output, keeping the first
# third and the last two thirds. DSH's pruner defaults to a 8,192-character trigger that
# retains only head 4,096 plus tail 1,024. Reading a large Kokkos header is exactly the
# case where that difference decides whether the model sees the code it needs.
- id: tool-result-pruner
  config:
    thresholdChars: 12000
    headChars: 4000
    tailChars: 8000

- insert:
    - id: hpc-sandbox-bash
      name: ${DSH_BRIDGE_PLUGIN}
