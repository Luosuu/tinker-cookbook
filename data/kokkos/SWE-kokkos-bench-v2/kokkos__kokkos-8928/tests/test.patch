+constexpr bool test_complex_conj() {
+  static_assert(Kokkos::conj(Kokkos::complex<double>{1., 1.}) ==
+                Kokkos::complex<double>{1., -1.});
+  static_assert(Kokkos::conj(Kokkos::complex<double>{1., -1.}) ==
+                Kokkos::complex<double>{1., 1.});
+  static_assert(Kokkos::conj(Kokkos::complex<double>{-1., 1.}) ==
+                Kokkos::complex<double>{-1., -1.});
+  static_assert(Kokkos::conj(Kokkos::complex<double>{-1., -1.}) ==
+                Kokkos::complex<double>{-1., 1.});
+  return true;
+}
+static_assert(test_complex_conj());
