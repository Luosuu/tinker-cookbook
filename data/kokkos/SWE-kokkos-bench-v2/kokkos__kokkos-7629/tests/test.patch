+// Helper for testing the 'then' node.
+template <typename ViewType>
+struct ThenFunctor {
+  static_assert(ViewType::rank() == 0);
+
+  ViewType data;
+  typename ViewType::value_type value;
+
+  KOKKOS_FUNCTION void operator()() const { data() += value; }
+};
