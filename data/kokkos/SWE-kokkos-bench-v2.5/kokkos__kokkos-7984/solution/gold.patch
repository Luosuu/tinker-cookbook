+#ifdef KOKKOS_ENABLE_DEPRECATED_CODE_4
+    using LayoutType = typename mdspan_type::layout_type;
+    if (r >= static_cast<iType>(rank())) {
+      if constexpr (std::is_same_v<LayoutType, layout_right> ||
